from building import *

cwd = GetCurrentDir()
project_root = Dir('#').abspath.replace('\\', '/')
cherryusb_root = project_root + '/libraries/components/CherryUSB-1.6.0'

src = [
    'usbh_uvc_app.c',
    'usbh_uvc_stream.c',
    'usbh_uvc_display.c',
    'tjpgd.c',
]

cpp_path = [
    cwd,
    project_root + '/applications',
    project_root + '/libraries/Common/deepcraft_ai/include',
    cherryusb_root + '/common',
    cherryusb_root + '/core',
    cherryusb_root + '/class/hub',
    cherryusb_root + '/class/video',
]

group = DefineGroup(
    'UsbUvc',
    src,
    depend=['RT_CHERRYUSB_HOST_VIDEO'],
    CPPPATH=cpp_path,
)

Return('group')
