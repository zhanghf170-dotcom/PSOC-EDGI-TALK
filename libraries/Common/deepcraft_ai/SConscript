from building import *
import os
import re

cwd = os.path.realpath(GetCurrentDir()).replace('\\', '/')
project_root = Dir('#').abspath.replace('\\', '/')
common_root = os.path.abspath(os.path.join(cwd, '..')).replace('\\', '/')
libraries_root = os.path.abspath(os.path.join(common_root, '..')).replace('\\', '/')
pdl_root = os.path.abspath(os.path.join(libraries_root, 'components', 'mtb-device-support-pse8xxgp', 'pdl')).replace('\\', '/')
usb_port = os.path.abspath(os.path.join(common_root, 'board', 'ports', 'usb')).replace('\\', '/')
ml_middleware = cwd + '/third_party/ml-middleware'
tflm_root = cwd + '/third_party/ml-tflite-micro/COMPONENT_ML_TFLM'
ethosu_root = pdl_root + '/drivers/third_party/COMPONENT_U55'

group = []

if not GetDepend(['BSP_USING_DEEPCRAFT_AI']):
    Return('group')

model_h = os.path.join(cwd, 'model', 'model.h')
model_c = os.path.join(cwd, 'model', 'model.c')
has_eye_model = False
if os.path.isfile(model_h) and os.path.isfile(model_c):
    with open(model_h, encoding='utf-8-sig', errors='replace') as model_header:
        has_eye_model = re.search(r'^\s*#define\s+IMAI_DATA_IN_COUNT\b',
                                  model_header.read(), re.MULTILINE) is not None

if not has_eye_model:
    group = DefineGroup('DeepcraftAi', ['src/uvc_ai_unavailable.c'],
                        depend=['RT_CHERRYUSB_HOST_VIDEO', 'BSP_USING_DEEPCRAFT_AI'],
                        CPPPATH=[cwd + '/include', usb_port])
    Return('group')

src = [
    'src/uvc_ai.c',
    'model/model.c',
    'third_party/ml-middleware/source/mtb_ml.c',
    'third_party/ml-middleware/source/mtb_ml_utils.c',
    'third_party/ml-middleware/source/COMPONENT_ML_TFLM/mtb_ml_model.cpp',
    'third_party/ml-middleware/source/COMPONENT_U55/mtb_ml_ethosu.c',
]

cpp_path = [
    cwd + '/include',
    cwd + '/model',
    usb_port,
    project_root + '/applications',
    ml_middleware + '/include',
    ml_middleware + '/source',
    ml_middleware + '/source/COMPONENT_ML_TFLM',
    tflm_root + '/include',
    tflm_root + '/include/flatbuffers/include',
    tflm_root + '/include/gemmlowp',
    tflm_root + '/include/gemmlowp/fixedpoint',
    tflm_root + '/include/ethos-u-core-driver',
    ethosu_root + '/include',
    ethosu_root + '/src',
]

cpp_defines = [
    'ARM_MATH_AUTOVECTORIZE',
    'ARM_MATH_DSP',
    'ARM_MATH_HELIUM',
    'COMPONENT_CM55',
    'COMPONENT_CM55_0',
    'COMPONENT_ML_INT8x8',
    'COMPONENT_ML_TFLM',
    'COMPONENT_U55',
    'ETHOSU55',
    'ML_IMAGIMOB_CM55',
    'MODEL_NAME=OBJECT_DETECT',
    'TF_LITE_STATIC_MEMORY',
    'CY_ML_ARENA_MEM=.cy_ml_arena_fast_data',
    'CY_ML_WORKING_MEM=.cy_ml_arena_fast_data',
]

local_arch_flags = ' -mcpu=cortex-m55 -mthumb -mfloat-abi=hard -mfpu=fpv5-d16 -march=armv8.1-m.main+fp.dp+mve'
opt_flags = ' -O3 -fno-math-errno -funroll-loops'

group = DefineGroup(
    'DeepcraftAi',
    src,
    depend=['RT_CHERRYUSB_HOST_VIDEO', 'BSP_USING_DEEPCRAFT_AI'],
    CPPPATH=cpp_path,
    CPPDEFINES=cpp_defines,
    LOCAL_CFLAGS=local_arch_flags + opt_flags,
    LOCAL_CXXFLAGS=local_arch_flags + opt_flags + ' -fno-exceptions -fno-rtti',
    LIBPATH=[tflm_root + '/COMPONENT_U55/TOOLCHAIN_GCC_ARM'],
    LIBS=['tensorflow-microlite'],
)

Return('group')
