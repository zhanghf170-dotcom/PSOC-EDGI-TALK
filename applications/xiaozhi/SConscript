from building import *
import os

cwd = GetCurrentDir()
proj_root = os.path.abspath(os.path.join(cwd, '..', '..')).replace('\\', '/')

path = [
    cwd,
    cwd + '/iot',
    cwd + '/mcp',
    proj_root + '/applications',
    proj_root + '/applications/ui',
    proj_root + '/libraries/HAL_Drivers',
    proj_root + '/libraries/Common/board/ports/audio',
    proj_root + '/libraries/Common/board/ports/usb',
    proj_root + '/packages/wavplayer-latest/inc',
]

src = Glob('*.c') + Glob('*.cpp')

group = DefineGroup('xiaozhi', src, depend=['BSP_USING_XIAOZHI_COCKPIT'], CPPPATH=path)

for item in os.listdir(cwd):
    sub = os.path.join(cwd, item, 'SConscript')
    if os.path.isfile(sub):
        group = group + SConscript(os.path.join(item, 'SConscript'))

Return('group')
