import rtconfig
from building import *
import os
Import('env')

cwd  = GetCurrentDir()
ports_root = os.path.abspath(os.path.join(cwd, '..', 'libraries', 'Common', 'board', 'ports')).replace('\\', '/')
common_root = os.path.abspath(os.path.join(cwd, '..', 'libraries', 'Common')).replace('\\', '/')
hal_root = os.path.abspath(os.path.join(cwd, '..', 'libraries', 'HAL_Drivers')).replace('\\', '/')
usb_port = ports_root + '/usb'
path = [
    cwd,
    cwd + '/xiaozhi',
    cwd + '/third_party',
    usb_port,
    hal_root,
    common_root + '/deepcraft_ai/include',
    cwd + '/../packages/wavplayer-latest/inc',
    cwd + '/../packages/aht10-latest/inc',
]
src = Glob('*.c', exclude=['cockpit_alarm_data.c', 'watch_wallpaper_data.c',
                           'xiaozhi_ding_data.c', 'xiaozhi_zh_ttf_data.c',
                           'xiaozhi_ding_wav.c', 'xiaozhi_zh_ttf.c', 'optional_media.c',
                           'gallery_photos.c', 'gallery_thumbnails.c'])

def embed_asset(target, source, env):
    name = env['ASSET_NAME']
    with open(str(source[0]), 'rb') as asset, open(str(target[0]), 'w') as output:
        data = asset.read()
        output.write('#include <stddef.h>\nconst unsigned char %s[] __attribute__((aligned(64))) = {\n' % name)
        for offset in range(0, len(data), 16):
            output.write('    ' + ', '.join(str(byte) for byte in data[offset:offset + 16]) + ',\n')
        output.write('};\nconst size_t %s_size = sizeof(%s);\n' % (name, name))

def embed_empty_assets(target, source, env):
    with open(str(target[0]), 'w') as output:
        output.write('#include <stddef.h>\n')
        for name, size in env['EMPTY_ASSETS']:
            output.write('const unsigned char %s[%d] __attribute__((aligned(64))) = {0};\n' %
                         (name, max(1, size)))
            output.write('const size_t %s_size = %d;\n' % (name, size))

media_dir = os.environ.get('EDGI_MEDIA_DIR')
media_root = Dir(os.path.abspath(media_dir)) if media_dir else Dir('#resources')
missing_assets = []

def optional_asset(filename, name, empty_size=0):
    asset = media_root.File(filename)
    if os.path.isfile(asset.abspath):
        return env.Command('#build/applications/' + name + '.c',
                           asset, embed_asset, ASSET_NAME=name)
    missing_assets.append((name, empty_size))
    return []

# Keep GB2312 Level-1 TTF in Flash when available so Chinese UI stays intact without TF card
src += optional_asset('xiaozhi_zh_l1.ttf', 'xiaozhi_zh_ttf')

if missing_assets:
    src += env.Command('#build/applications/optional_media.c', File('#applications/SConscript'),
                       embed_empty_assets, EMPTY_ASSETS=tuple(missing_assets))

group = DefineGroup('Applications', src, depend = [''], CPPPATH = path)

list = os.listdir(cwd)
for item in list:
    if os.path.isfile(os.path.join(cwd, item, 'SConscript')):
        group = group + SConscript(os.path.join(item, 'SConscript'))

Return('group')
